{
  "presets": [
    "babel-preset-env", 
    "babel-preset-react",
    ["env", {
      "targets": {
        "browsers": ["last 2 versions", "safari >= 7"]
      },
      "include": ["transform-es2015-arrow-functions", "es6.map"],
      "exclude": ["transform-regenerator", "es6.set"]
    }]
  ],
  "plugins": ["transform-object-rest-spread"]
}